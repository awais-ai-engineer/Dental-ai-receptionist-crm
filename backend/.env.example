RAG_MAX_DISTANCE=0.45
RAG_TOP_K=5
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=180
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
